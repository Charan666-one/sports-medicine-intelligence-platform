// NEXUS Intelligence Platform — Prisma schema (PostgreSQL).
// Migrations live in prisma/migrations. Seed data is separate (prisma/seed.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// --- CORE IDENTITY & ACCESS ---

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  athletes      Athlete[]
  roles         Role[]
  ingestionJobs IngestionJob[]
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  isActive Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  notifications  Notification[]
  activityLogs   ActivityLog[]
  reportsCreated MedicalReport[] @relation("ReportCreator")
  ingestionJobs  IngestionJob[]
  refreshTokens  RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([roleId])
}

model Role {
  id          String  @id @default(uuid())
  name        String
  description String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  permissions Permission[]
  users       User[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model Permission {
  id       String @id @default(uuid())
  action   String // e.g., "REPORT_CREATE", "ATHLETE_VIEW"
  resource String // e.g., "MEDICAL_REPORTS", "ATHLETES"
  roles    Role[]
}

// Phase 9: short-lived JWT access tokens + long-lived, rotatable refresh
// tokens. Only the SHA-256 hash of the opaque refresh token is stored — the
// raw token is never persisted, only handed to the client once. Rotation
// chains (replacedById) let a reused/revoked token be detected as a
// possible theft and immediately revoke the whole chain.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /** id of the token that replaced this one, once rotated. */
  replacedById String?

  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// --- ATHLETE DOMAIN ---

enum AthleteStatus {
  ACTIVE
  SUSPENDED
  RETIRED
  UNDER_INVESTIGATION
}

model Athlete {
  id          String        @id @default(uuid())
  externalId  String?       @unique
  name        String
  dateOfBirth DateTime
  gender      String
  nationality String
  sport       String
  status      AthleteStatus @default(ACTIVE)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  medicalProfile AthleteMedicalProfile?

  reports            MedicalReport[]
  riskAssessments    RiskAssessment[]
  biologicalPassport BiologicalPassport?
  alerts             Alert[]
  aiPredictions      AIPrediction[]
  inspections        Inspection[]
  ingestionJobs      IngestionJob[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([status])
}

model Inspection {
  id          String  @id @default(uuid())
  title       String
  description String?
  status      String  @default("OPEN") // OPEN, IN_PROGRESS, CLOSED, ESCALATED
  priority    String  @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL

  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  assignedTo String? // Analyst Name
  findings   String? // Rich text findings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@index([status])
}

model AthleteMedicalProfile {
  id        String  @id @default(uuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  bloodType String?
  allergies String?
  history   String?

  updatedAt DateTime @updatedAt
}

// --- MEDICAL INTELLIGENCE ---

enum ReportType {
  BLOOD
  URINE
  BIOLOGICAL_PASSPORT
  WEARABLE_LOG
}

enum ReportStatus {
  PENDING
  REVIEWING
  COMPLETED
  FLAGGED
  ARCHIVED
}

model MedicalReport {
  id          String       @id @default(uuid())
  type        ReportType
  status      ReportStatus @default(PENDING)
  description String?

  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  creatorId String
  creator   User   @relation("ReportCreator", fields: [creatorId], references: [id])

  // INGESTION ENHANCEMENTS
  fileUrl  String?
  fileName String?
  fileType String? // pdf, jpg, png, csv

  ocrRawText    String? // Full extracted text (encrypted at rest)
  extractedJSON String? // Structured data before validation (encrypted at rest)

  ocrConfidence     Float?  @default(0)
  parsingConfidence Float?  @default(0)
  extractionQuality String? // EXCELLENT, GOOD, POOR

  validationStatus String? @default("PENDING") // VALID, INVALID, INCOMPLETE
  validationNotes  String?
  // Categorized data-quality findings (Phase 4) — JSON array of
  // { category: DATA_ERROR | PHYSIOLOGICAL_ANOMALY | RISK_SIGNAL, parameter, message }.
  // See src/types/dataQuality.ts.
  dataQualityFindings String?

  testResults TestResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteId])
  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
}

model TestResult {
  id       String        @id @default(uuid())
  reportId String
  report   MedicalReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  parameter  String
  value      Float
  unit       String
  isAtypical Boolean @default(false)
  deviation  Float?

  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([parameter])
}

model BiologicalPassport {
  id        String  @id @default(uuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  hematologicalMarkers String
  steroidalMarkers     String
  lastAnalyzedAt       DateTime
}

// --- ANALYTICS & MONITORING ---

model RiskAssessment {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  score     Float
  category  String
  modelName String @default("V1_HEURISTIC")
  findings  String

  createdAt DateTime @default(now())

  @@index([athleteId])
  @@index([createdAt])
}

model Alert {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  severity   String
  message    String
  isResolved Boolean   @default(false)
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([athleteId])
  @@index([isResolved])
}

// --- OBSERVE & AUDIT ---

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title   String
  content String
  isRead  Boolean @default(false)
  type    String

  createdAt DateTime @default(now())

  @@index([userId])
}

model ActivityLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  action    String
  details   String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String  @id @default(uuid())
  tableName String
  recordId  String
  operation String
  oldValue  String?
  newValue  String?
  changedBy String

  createdAt DateTime @default(now())

  @@index([tableName, recordId])
  @@index([createdAt])
}

model AIPrediction {
  id        String  @id @default(uuid())
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  riskLevel       String
  riskProbability String

  isAnomaly    Boolean
  anomalyScore Float
  isAtypical   Boolean

  explanation       String
  featureImportance String

  // XAI Enhancements
  confidenceScore  Float   @default(0)
  reliabilityLabel String  @default("UNRELIABLE") // HIGH, MODERATE, LOW
  stabilityIndex   Float   @default(0)
  reasoningJSON    String? // Detailed medical reasoning chunks
  longitudinalData String? // Trends and historical delta JSON
  uncertaintyData  String? // Uncertainty metrics

  modelInfo String

  // Versioned analysis / reproducibility (Phase 8). AIPrediction rows are
  // append-only (never updated in place), so history is already preserved;
  // these fields let a specific prediction be traced back to exactly which
  // engine/rules logic and which input values produced it.
  engineVersion String @default("unversioned") // deterministic risk/anomaly engine code version
  rulesVersion  String @default("unversioned") // physiological threshold/rules version
  inputHash     String @default("") // SHA-256 of the feature vector this prediction was computed from

  createdAt DateTime @default(now())

  @@index([athleteId])
  @@index([createdAt])
  @@index([inputHash])
}

// --- ASYNCHRONOUS INGESTION (Phase 3) ---

enum IngestionJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

// Durable record of an ingestion job, independent of the BullMQ/Redis queue's
// own (ephemeral, TTL'd) job state. The API reads job status from this table
// so a status lookup never depends on Redis being reachable, and so job
// history survives beyond the queue's retention window. Also carries the
// file metadata described in Phase 2 (checksum, mime, size, uploader) so the
// object-storage migration in that phase is additive, not a rework of this one.
model IngestionJob {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Null until an athlete is resolved (auto-match jobs don't know the athlete
  // until the worker parses the document and runs AthleteMatchService).
  athleteId String?
  athlete   Athlete? @relation(fields: [athleteId], references: [id])

  // Set once the worker creates the MedicalReport row.
  reportId String? @unique

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id])

  fileName  String
  filePath  String
  mimeType  String
  sizeBytes Int
  checksum  String // sha256 of the uploaded bytes — used for idempotent re-submit detection

  status        IngestionJobStatus @default(QUEUED)
  stage         String? // current pipeline stage, e.g. OCR_PARSING, VALIDATION, RISK_ANALYSIS
  progress      Int                @default(0) // 0..100
  attempts      Int                @default(0)
  error         String?
  resultSummary String? // JSON: { biomarkerCount, riskLevel, isAnomaly, ... } once COMPLETED

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([organizationId])
  @@index([organizationId, checksum])
  @@index([status])
  @@index([athleteId])
}
