# ─────────────────────────────────────────────────────────────
# Environment configuration — copy this file to `.env`
#   cp .env.example .env
# `npm run setup` does this automatically if `.env` is missing.
# ─────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Server port
PORT=3000

# Prisma / SQLite database location (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# JWT signing secret — CHANGE THIS to a long random string before deploying.
JWT_SECRET="development-secret-key-change-me"

# Allowed CORS origin ("*" for local dev)
CORS_ORIGIN="*"

# GEMINI_API_KEY: optional. Enables LLM-enhanced medical summaries.
# Leave as the placeholder to run in fully deterministic mode (no external calls).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
