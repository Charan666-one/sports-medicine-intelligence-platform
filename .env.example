# ─────────────────────────────────────────────────────────────
# Environment configuration — copy this file to `.env`
#   cp .env.example .env
# `npm run setup` copies it AND fills in strong random secrets automatically.
# ─────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL connection. Local dev default matches docker-compose / setup.
DATABASE_URL="postgresql://nexus:nexus@127.0.0.1:5432/nexus?schema=public"
# Shadow DB used by `prisma migrate dev` in development only (not needed in prod).
SHADOW_DATABASE_URL="postgresql://nexus:nexus@127.0.0.1:5432/nexus_shadow?schema=public"

# JWT signing secret — MUST be a long random string (>=16 chars, use 32+).
# Required in production. `npm run setup` generates one for you.
JWT_SECRET="change-me-to-a-long-random-string-min-16-chars"

# Access token lifetime — kept short; sessions stay alive via the refresh
# token (rotated on each use), not by extending this.
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# AES-256-GCM key for encrypting sensitive medical data at rest (>=32 chars).
# Required in production. Keep it STABLE — changing it makes existing encrypted
# rows unreadable. `npm run setup` generates one for you.
ENCRYPTION_KEY="change-me-to-a-32-byte-encryption-key-please"

# Allowed CORS origins. "*" is fine for local dev; in production set an explicit
# comma-separated list, e.g. "https://app.example.com".
CORS_ORIGIN="*"

# GEMINI_API_KEY: optional. Enables LLM-enhanced medical summaries.
# Leave as the placeholder to run in fully deterministic mode (no external calls).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Uploaded medical report storage: "local" (default) | "s3".
# "local" writes to the container's own disk — fine for single-instance dev,
# but NOT durable in production (lost on redeploy, not shared across
# instances). Set STORAGE_DRIVER=s3 and the STORAGE_S3_* vars below before
# deploying for real — see ENGINEERING_READINESS.md blocker B1.
STORAGE_DRIVER=local
# STORAGE_S3_BUCKET=nexus-medical-reports
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# Only set for a non-AWS S3-compatible provider (MinIO, Cloudflare R2, etc).
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_FORCE_PATH_STYLE=false

# Optional: gates GET /api/metrics with `Authorization: Bearer <token>`.
# Leave unset to leave metrics open (fine if restricted at the network/
# ingress layer instead — the same trust model as /api/health today).
# METRICS_TOKEN=

# Port for the WORKER process's own metrics server (GET /metrics, no path
# prefix, no auth gate). The worker is a separate OS process from the API —
# ingestion_jobs_total is only ever incremented there, so it needs its own
# scrape target; a real deployment scrapes both this and the API's
# /api/metrics.
WORKER_METRICS_PORT=9091
