{
  "name": "nexus-sports-medicine-intelligence-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "start": "NODE_ENV=production tsx src/server.ts",
    "start:worker": "NODE_ENV=production tsx src/worker.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "docs:validate": "node scripts/validateOpenApi.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "ml-isolation-forest": "^0.1.0",
    "ml-random-forest": "^2.1.0",
    "multer": "^2.1.1",
    "otplib": "^13.5.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.2.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "simple-statistics": "^7.8.9",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prettier": "^3.9.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
