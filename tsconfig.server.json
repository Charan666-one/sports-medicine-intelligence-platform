{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/server.ts",
    "src/app.ts",
    "src/config",
    "src/controllers",
    "src/routes",
    "src/middlewares",
    "src/services/*.ts",
    "src/utils",
